// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

// Models
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  username      String?    @unique
  password      String?
  firstName     String?
  lastName      String?
  avatar        String?
  githubId      String?    @unique
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)

  // Context Engineering - User Preferences
  defaultSubscriptionId   String?
  defaultRegion           String?
  costAlertThreshold      Decimal? @db.Decimal(10, 2)
  notificationPreferences Json?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  refreshTokens       RefreshToken[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  conversations       Conversation[]
  costSnapshots       CostSnapshot[]
  recommendations     Recommendation[]
  budgets             Budget[]

  @@index([email])
  @@index([username])
  @@index([githubId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// Azure Cloud Resources Models
enum AzureResourceType {
  VIRTUAL_MACHINE
  STORAGE_ACCOUNT
  SQL_DATABASE
  APP_SERVICE
  FUNCTION_APP
  KUBERNETES_SERVICE
  COSMOS_DB
  KEY_VAULT
  OTHER
}

enum AzureResourceStatus {
  RUNNING
  STOPPED
  DEALLOCATED
  FAILED
  UNKNOWN
}

model AzureSubscription {
  id             String @id @default(cuid())
  subscriptionId String @unique
  displayName    String
  tenantId       String
  state          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  resources   AzureResource[]
  costRecords AzureCostRecord[]

  @@index([subscriptionId])
  @@index([tenantId])
  @@map("azure_subscriptions")
}

model AzureResource {
  id             String              @id @default(cuid())
  resourceId     String              @unique
  name           String
  type           AzureResourceType
  resourceType   String // Full Azure resource type
  location       String
  resourceGroup  String
  subscriptionId String
  status         AzureResourceStatus @default(UNKNOWN)
  sku            String?
  tags           Json? // Store tags as JSON
  properties     Json? // Store additional properties as JSON

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSyncedAt DateTime @default(now())

  // Relations
  subscription AzureSubscription @relation(fields: [subscriptionId], references: [subscriptionId], onDelete: Cascade)

  @@index([resourceId])
  @@index([subscriptionId])
  @@index([resourceGroup])
  @@index([type])
  @@index([location])
  @@map("azure_resources")
}

model AzureCostRecord {
  id             String   @id @default(cuid())
  subscriptionId String
  resourceGroup  String?
  resourceId     String?
  serviceName    String
  meterCategory  String?
  usageStart     DateTime
  usageEnd       DateTime
  cost           Float
  currency       String   @default("USD")
  quantity       Float?
  unitOfMeasure  String?

  createdAt DateTime @default(now())

  // Relations
  subscription AzureSubscription @relation(fields: [subscriptionId], references: [subscriptionId], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([resourceGroup])
  @@index([usageStart])
  @@index([usageEnd])
  @@map("azure_cost_records")
}

model AzureSyncLog {
  id           String    @id @default(cuid())
  syncType     String // 'resources', 'costs', or 'activity_logs'
  status       String // 'success', 'failed', 'in_progress'
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  recordsSync  Int?
  errorMessage String?

  @@index([syncType])
  @@index([status])
  @@index([startedAt])
  @@map("azure_sync_logs")
}

// Azure Activity Logs for audit trail and operations monitoring
model AzureActivityLog {
  id                   String   @id @default(cuid())
  subscriptionId       String
  eventTimestamp       DateTime
  eventDataId          String   @unique
  correlationId        String?
  operationName        String
  operationId          String?
  level                String // Informational, Warning, Error, Critical
  status               String? // Started, Succeeded, Failed
  subStatus            String?
  caller               String? // User or service principal who initiated the operation
  category             String // Administrative, Security, ServiceHealth, Alert, etc.
  resourceId           String?
  resourceGroupName    String?
  resourceType         String?
  resourceProviderName String?
  eventName            String?
  description          String?
  httpRequest          Json? // HTTP request details
  authorization        Json? // Authorization details
  claims               Json? // Claims from the token
  properties           Json? // Additional properties

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@index([eventTimestamp])
  @@index([operationName])
  @@index([category])
  @@index([level])
  @@index([caller])
  @@index([resourceGroupName])
  @@map("azure_activity_logs")
}

// AI Chat Conversations and Messages
enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Conversation {
  id       String  @id @default(cuid())
  title    String
  userId   String
  isActive Boolean @default(true)
  metadata Json? // Store current_topic, entities_discussed, pending_actions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        Message[]
  recommendations Recommendation[]
  aiActions       AiAction[]

  @@index([userId])
  @@index([createdAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  toolsUsed      String[]    @default([])
  tokensUsed     Int?

  createdAt DateTime @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

// Context Engineering Models

// Cost Snapshots for historical analysis
model CostSnapshot {
  id               String   @id @default(cuid())
  userId           String
  subscriptionId   String
  date             DateTime @db.Date
  totalCost        Decimal  @db.Decimal(10, 2)
  serviceBreakdown Json? // { "compute": 450, "storage": 200, ... }
  topResources     Json? // [{ name, cost, type }, ...]

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, date])
  @@index([userId])
  @@index([subscriptionId])
  @@index([date])
  @@map("cost_snapshots")
}

// AI Recommendations for cost optimization, security, performance
enum RecommendationType {
  COST_OPTIMIZATION
  SECURITY
  PERFORMANCE
  RELIABILITY
  OPERATIONAL_EXCELLENCE
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  IGNORED
}

model Recommendation {
  id               String               @id @default(cuid())
  userId           String
  conversationId   String?
  type             RecommendationType
  resourceId       String?
  recommendation   String               @db.Text
  potentialSavings Decimal?             @db.Decimal(10, 2)
  status           RecommendationStatus @default(PENDING)
  metadata         Json? // Additional context, impact analysis, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([conversationId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("ai_recommendations")
}

// Cache for API schemas from Context7 and Azure docs
model ApiSchemaCache {
  id        String   @id @default(cuid())
  service   String
  operation String
  schema    Json
  source    String? // 'context7' | 'azure_docs' | 'mcp'
  cachedAt  DateTime @default(now())
  expiresAt DateTime

  @@unique([service, operation])
  @@index([service])
  @@index([expiresAt])
  @@map("api_schema_cache")
}

// User budgets and alerts
model Budget {
  id                   String   @id @default(cuid())
  userId               String
  subscriptionId       String
  name                 String
  monthlyLimit         Decimal  @db.Decimal(10, 2)
  alertThresholds      Int[] // [80, 90, 100] - percentage thresholds
  notificationChannels String[] // ['email', 'slack', 'teams']
  isActive             Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([isActive])
  @@map("budgets")
}

// Track AI actions for audit and learning
model AiAction {
  id             String  @id @default(cuid())
  conversationId String
  actionType     String // 'tool_call', 'recommendation', 'query', etc.
  toolName       String?
  parameters     Json?
  result         Json?
  success        Boolean
  errorMessage   String? @db.Text
  durationMs     Int? // Execution time in milliseconds

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([actionType])
  @@index([toolName])
  @@index([success])
  @@index([createdAt])
  @@map("ai_actions")
}
