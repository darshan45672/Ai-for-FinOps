# ============================================
# AI FinOps - Production Environment Configuration
# ============================================
# This file contains all environment variables needed for production deployment
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit the .env file to version control!

# ============================================
# Node Environment
# ============================================
NODE_ENV=production

# ============================================
# PostgreSQL Database Configuration
# ============================================
POSTGRES_USER=finops
POSTGRES_PASSWORD=change_this_secure_password_12345
POSTGRES_DB=ai_finops

# Database URLs for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://finops:change_this_secure_password_12345@postgres:5432/ai_finops
DIRECT_URL=postgresql://finops:change_this_secure_password_12345@postgres:5432/ai_finops

# Data persistence paths
POSTGRES_DATA_PATH=./data/postgres
REDIS_DATA_PATH=./data/redis

# ============================================
# Redis Cache Configuration
# ============================================
REDIS_PASSWORD=change_this_redis_password_67890
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# JWT Authentication Configuration
# ============================================
# Generate strong secrets using: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARACTERS
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS Configuration
# ============================================
# Allowed origins for CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3003,https://yourdomain.com

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# ============================================
# Azure Credentials (for FinOps integration)
# ============================================
# Get these from Azure Portal > App Registrations
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# ============================================
# GitHub OAuth Configuration (Optional)
# ============================================
# Set up at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# ============================================
# Application Configuration
# ============================================
# Service Ports (internal Docker network)
AUTH_SERVICE_PORT=3001
BACKEND_SERVICE_PORT=3000
DATABASE_SERVICE_PORT=3002
FRONTEND_SERVICE_PORT=3003

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://authentication:3001
BACKEND_SERVICE_URL=http://backend:3000
DATABASE_SERVICE_URL=http://database:3002

# ============================================
# Security Configuration
# ============================================
# Enable security features
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Email Configuration (for password reset, etc.)
# ============================================
# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=AI FinOps <noreply@example.com>

# ============================================
# Container Registry (Optional)
# ============================================
# If you want to push images to a registry
REGISTRY=localhost
VERSION=1.0.0

# ============================================
# Monitoring & Observability (Optional)
# ============================================
# SENTRY_DSN=your-sentry-dsn
# DATADOG_API_KEY=your-datadog-api-key
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# ============================================
# Production Optimizations
# ============================================
# Node.js Memory Limits (in MB)
NODE_OPTIONS=--max-old-space-size=1024

# Timezone
TZ=UTC

# ============================================
# Backup Configuration (Recommended for Production)
# ============================================
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=your-backup-bucket
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret

# ============================================
# SSL/TLS Configuration (for production with reverse proxy)
# ============================================
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
