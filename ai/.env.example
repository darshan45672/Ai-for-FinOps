# AI Service Environment Configuration

# Service Configuration
NODE_ENV=development
PORT=3004

# ============================================================
# AZURE AI FOUNDRY CONFIGURATION (REQUIRED)
# ============================================================
# 
# To get these values:
# 1. Go to https://ai.azure.com/
# 2. Open your project
# 3. Go to Settings → Project details
# 4. Copy the "Project endpoint" (NOT the API key!)
#
# Format: https://<project>.services.ai.azure.com/api/projects/<project-name>
# Example: https://my-finops-ai.services.ai.azure.com/api/projects/ai-finops-assistant
#
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project-name

# Model deployment name (created in Azure AI Foundry portal)
# Recommended: gpt-4o for best function calling support
AZURE_AI_FOUNDRY_MODEL_DEPLOYMENT=gpt-4o

# ============================================================
# AUTHENTICATION
# ============================================================
# 
# Azure AI Foundry uses DefaultAzureCredential for authentication
# Make sure you're logged in with Azure CLI:
#   az login
#
# Verify your account:
#   az account show
#

# ============================================================
# SERVICE URLs
# ============================================================

# Database Service URL (for MCP tools to fetch Azure data)
DATABASE_SERVICE_URL=http://localhost:3002

# Backend Service URL (for metrics)
BACKEND_SERVICE_URL=http://localhost:3001

# ============================================================
# LOGGING & CORS
# ============================================================

# Logging level
LOG_LEVEL=info

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# LEGACY OLLAMA CONFIGURATION (NO LONGER USED)
# ============================================================
# These settings are kept for reference but are not used anymore
# The application now uses Azure AI Foundry instead of Ollama
#
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=mistral:latest
